___TESTS___

scenarios:
- name: Loads the widget with the key
  code: |-
    mock('injectScript', (url, onSuccess) => {
      assertThat(url).isEqualTo('https://chatonpage.com/widget.js?key=pk_test12345');
      onSuccess();
    });
    runCode({publicKey: 'pk_test12345', position: 'right', locale: 'auto', openAutomatically: false, greeting: true});
    assertApi('gtmOnSuccess').wasCalled();
- name: Passes position, language, open and greeting
  code: |-
    mock('injectScript', (url, onSuccess) => {
      assertThat(url).isEqualTo('https://chatonpage.com/widget.js?key=pk_test12345&position=left&locale=fr&open=true&nudge=off');
      onSuccess();
    });
    runCode({publicKey: 'pk_test12345', position: 'left', locale: 'fr', openAutomatically: true, greeting: false});
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails without a key
  code: |-
    runCode({publicKey: '', position: 'right', locale: 'auto', openAutomatically: false, greeting: true});
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();


