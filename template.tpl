___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const queryPermission = require('queryPermission');
const logToConsole = require('logToConsole');

const LOCALES = ['nl', 'en', 'fr', 'de', 'es'];

let url = 'https://chatonpage.com/widget.js?key=' + encodeUriComponent(data.publicKey || '');
if (data.position === 'left') {
  url += '&position=left';
}
if (LOCALES.indexOf(data.locale) !== -1) {
  url += '&locale=' + data.locale;
}
if (data.openAutomatically) {
  url += '&open=true';
}
if (!data.greeting) {
  url += '&nudge=off';
}

if (!data.publicKey || !queryPermission('inject_script', url)) {
  logToConsole('Chat on Page: no public key, or the widget URL is not allowed.');
  data.gtmOnFailure();
} else {
  // The cache id loads the widget only once per page, also when the tag fires again.
  injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, 'chatonpage');
}


